{
  "name": "type-infer",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "esbuild build package template",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/monorepo-template.git",
    "directory": "packages/foo"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/monorepo-template/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --sourcemap --no-clean",
    "build:watch": "tsdown --watch --sourcemap --no-clean",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {},
  "dependencies": {
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "lru-cache": "^11.5.2",
    "magic-string": "^1.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4"
  }
}
