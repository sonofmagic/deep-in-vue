{
  "name": "compile-time-directive",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "esbuild build package template",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonofmagic/monorepo-template.git",
    "directory": "packages/foo"
  },
  "bugs": {
    "url": "https://github.com/sonofmagic/monorepo-template/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch --sourcemap --no-clean",
    "build:watch": "tsdown --watch --sourcemap --no-clean",
    "build": "tsdown",
    "test": "vitest run",
    "test:dev": "vitest",
    "release": "pnpm publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "debug:sfc": "node --import tsx scripts/compile-sfc.ts",
    "script:compile": "pnpm debug:sfc",
    "script:v-file": "tsx scripts/run-custom-directive.ts"
  },
  "publishConfig": {},
  "peerDependencies": {
    "@vue/compiler-core": "^3.5.40"
  },
  "devDependencies": {
    "@vue/compiler-core": "^3.5.40",
    "@vue/compiler-sfc": "^3.5.40",
    "tsx": "^4.23.1",
    "vue": "^3.5.40"
  }
}
